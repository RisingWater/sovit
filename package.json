{
  "name": "sovit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn-based state-owned economy sandbox — engine + AI interface",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "sim": "node --experimental-strip-types scripts/simulate.ts",
    "test": "tsc --noEmit && tsc -p tsconfig.ui.json && node --experimental-strip-types scripts/simulate.ts",
    "regress": "npm run test",
    "api": "node --experimental-strip-types src/api/server.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.7.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
