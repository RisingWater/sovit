{
  "name": "sovit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn-based state-owned economy sandbox — engine + AI interface",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:content": "node --experimental-strip-types scripts/check-content.ts",
    "gen:art": "node --experimental-strip-types scripts/gen-art.ts",
    "sync:content": "node --experimental-strip-types scripts/sync-content.ts",
    "golden": "node --experimental-strip-types scripts/golden.ts",
    "sim": "node --experimental-strip-types scripts/simulate.ts",
    "test": "tsc --noEmit && node --experimental-strip-types scripts/check-content.ts && node --experimental-strip-types scripts/golden.ts && node --experimental-strip-types scripts/simulate.ts",
    "regress": "npm run test",
    "api": "node --experimental-strip-types src/api/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
